---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/ContactPage.astro';
---
<BaseLayout title="Simulado VemMED | VemMED" description="Pratique em formato de prova, perceba quais conteúdos ainda merecem atenção e direcione seus próximos estudos.">
  <main id="conteudo">
    <section class="hero" aria-labelledby="hero-title">
      <span class="decoration-circle" aria-hidden="true"></span>
      <span class="decoration-diamond" aria-hidden="true"></span>
      <div class="hero__inner">
        <div class="hero__copy">
          <a class="wordmark" href="#conteudo" aria-label="VemMED, início">
            <img src="/assets/logo-vemmed.svg" alt="VemMED" />
          </a>
          <p class="page-badge">SIMULADO VEMMED</p>
          <h1 id="hero-title">Simulado VemMED</h1>
          <p class="hero__lead">Reserve um momento para colocar seus conhecimentos em prática e observar como você enfrenta uma prova. Use essa experiência para reconhecer dificuldades e pensar nos próximos passos da sua preparação, respeitando seu ritmo.</p>
          <div class="hero__access" role="note" aria-label="Acesso gratuito">
            <span class="hero__access-check" aria-hidden="true">✓</span>
            <div>
              <p class="hero__access-title">Acesso gratuito.</p>
              <p class="hero__access-description">Solicite a liberação pelo formulário.</p>
            </div>
          </div>
        </div>
        <aside class="capture-panel" id="cadastro" aria-labelledby="panel-title">
          <p class="capture-panel__eyebrow">ACESSO AO APLICATIVO</p>
          <p class="capture-panel__description" id="panel-title">Solicite acesso ao Simulado VemMED e comece a praticar.</p>
          <ContactPage />
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
