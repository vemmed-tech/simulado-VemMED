---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/ContactPage.astro';
---
<BaseLayout title="Simulado VemMED — 2º dia do ENEM | VemMED" description="Prepare-se para o segundo dia do ENEM com o Simulado VemMED: uma prova autoral de Matemática e Ciências da Natureza, com acesso gratuito.">
  <main id="conteudo">
    <section class="hero" aria-labelledby="hero-title">
      <span class="decoration-circle" aria-hidden="true"></span>
      <span class="decoration-diamond" aria-hidden="true"></span>
      <div class="hero__inner">
        <div class="hero__copy">
          <a class="wordmark" href="#conteudo" aria-label="VemMED, início">
            <img src="/assets/logo-vemmed.svg" alt="VemMED" />
          </a>
          <p class="page-badge">SIMULADO VEMMED · 2º DIA</p>
          <h1 id="hero-title">Simulado VemMED — 2º dia</h1>
          <p class="hero__lead">Prepare-se para o segundo dia do ENEM com uma prova autoral de Matemática e Ciências da Natureza: Biologia, Física e Química. Coloque seus conhecimentos em prática, identifique suas dificuldades e descubra o que priorizar na próxima etapa dos estudos.</p>
          <div class="hero__access" role="note" aria-label="Acesso gratuito">
            <span class="hero__access-check" aria-hidden="true">✓</span>
            <div>
              <p class="hero__access-title">Acesso gratuito.</p>
              <p class="hero__access-description">Solicite seu simulado do segundo dia pelo formulário.</p>
            </div>
          </div>
        </div>
        <aside class="capture-panel" id="cadastro" aria-labelledby="panel-title">
          <p class="capture-panel__eyebrow">PREPARE-SE PARA O 2º DIA</p>
          <h2 id="panel-title">Receba seu simulado</h2>
          <p class="capture-panel__description">Acesse gratuitamente e pratique Matemática e Ciências da Natureza no estilo ENEM.</p>
          <ContactPage />
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
